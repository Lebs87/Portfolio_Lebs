{
  "author": "Luis Belisario",
  "name": "portfolio_ene_2024",
  "version": "1.2.0",
  "description": "Portfolio Luis Belisario",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "build-css": "sass scss/main.scss assets/css/style.css --no-source-map",
    "build-cv": "sass scss/cv.scss assets/css/cv.css --no-source-map",
    "build": "npm run build-css && npm run build-cv",
    "watch-css": "sass --watch scss/main.scss:assets/css/style.css scss/cv.scss:assets/css/cv.css"
  },
  "license": "ISC",
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sass": "^1.77.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lebs87/Portfolio2024.git"
  }
}
